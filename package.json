{
	"name": "recruiting",
	"version": "0.1.0",
	"private": true,
	"description": "Manage job applications, screening, interviews and rejections in Nextcloud",
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"scripts": {
		"build": "vite --mode production build",
		"dev": "vite --mode development build",
		"watch": "vite --mode development build --watch",
		"lint": "eslint",
