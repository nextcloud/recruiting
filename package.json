		"stylelint": "stylelint src/**/*.scss src/**/*.vue src/**/*.css",
		"stylelint:fix": "stylelint src/**/*.scss src/**/*.vue src/**/*.css --fix"
	},
	"browserslist": [
		"extends @nextcloud/browserslist-config"
